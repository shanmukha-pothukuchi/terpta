# --- Frontend (Vite) environment variables ---
# Copy to .env.local for local development. Never commit real values.

# Convex deployment URL. Written automatically by `npx convex dev` into .env.local;
# only set manually when pointing at a specific cloud deployment.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# WorkOS AuthKit client id (from the WorkOS dashboard, Applications page).
VITE_WORKOS_CLIENT_ID=client_xxxxxxxxxxxxxxxx

# OAuth redirect URI. Must exactly match a redirect URI registered in WorkOS.
# Local dev: http://localhost:5173/callback
# Production: https://shanmukha-pothukuchi.github.io/terpta/callback
VITE_WORKOS_REDIRECT_URI=http://localhost:5173/callback
